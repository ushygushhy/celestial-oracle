# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# NOMINATIM_CONTACT=you@example.com     # added to the geocoder User-Agent, per OSM policy
# SE_EPHE_PATH=/absolute/path/to/ephe   # defaults to ./ephe
# DATABASE_PATH=/absolute/path/to/celestial.db   # defaults to ./data/celestial.db
